{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "komikhq-media-pages",
  "compatibility_date": "2026-10-09",
  "vars": {
    "CORS_POLICY": "[]"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "komikhq-media"
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "CORS_POLICY": "[]"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "komikhq-media-preview"
        }
      ]
    },
    "production": {
      "vars": {
        "CORS_POLICY": "[]"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "komikhq-media"
        }
      ]
    }
  }
}
