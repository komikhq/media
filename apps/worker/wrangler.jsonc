{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The deployed Worker name; this must match the Cloudflare Workers project.
  "name": "komikhq-media-worker",
  // The module entry point that Wrangler bundles and deploys.
  "main": "src/index.ts",
  // Serve the Worker app's static brand and favicon files before media handling.
  "assets": {
    // Directory containing the static files deployed with this Worker.
    "directory": "./public",
    // Keep matching static files out of the R2 delivery handler.
    "binding": "ASSETS"
  },
  // The runtime compatibility date used to select Workers platform behavior.
  "compatibility_date": "2026-10-09",
  // Enable the public <name>.<account-subdomain>.workers.dev route.
  "workers_dev": true,
  // Enable per-version workers.dev URLs for testing deployed versions.
  "preview_urls": true,
  // Enable Workers Cache; responses are cached according to their Cache-Control headers.
  "cache": {
    "enabled": true
  },
  // Collect production Worker logs and a sampled set of traces.
  "observability": {
    // Turn on the observability configuration below.
    "enabled": true,
    // Keep all Worker logs for production troubleshooting.
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    // Sample one percent of traces to limit telemetry volume.
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  // Bind the production R2 bucket and use a local-only bucket name in Wrangler dev.
  "r2_buckets": [
    {
      // The binding name consumed by the Worker source code.
      "binding": "MEDIA_BUCKET",
      // The remote bucket used by production deployments; replace for your account.
      "bucket_name": "komikhq-media",
      // The local R2 simulation name used during local development.
      "preview_bucket_name": "komikhq-media-preview",
      // Keep Wrangler development on its local R2 simulation.
      "remote": false
    }
  ],
  // Settings for branch-oriented Workers Builds Previews, not Version URLs.
  "previews": {
    // Give branch previews a dedicated test bucket rather than production media.
    "r2_buckets": [
      {
        // Match the binding name referenced by the Worker code.
        "binding": "MEDIA_BUCKET",
        // The R2 bucket used by Workers Builds Previews; replace for your account.
        "bucket_name": "komikhq-media-preview",
      }
    ],
    // Enable Workers Cache for branch previews as well.
    "cache": {
      "enabled": true
    }
  },
  // A separately deployable named Wrangler environment for persistent preview use.
  "env": {
    "preview": {
      // The Cloudflare Worker name created for this named environment.
      "name": "komikhq-media-worker-preview",
      // Bind the named environment to its own preview R2 bucket.
      "r2_buckets": [
        {
          // Keep the binding name consistent with the Worker source code.
          "binding": "MEDIA_BUCKET",
          // The remote preview bucket used when this named environment is deployed.
          "bucket_name": "komikhq-media-preview",
          // The local simulation name for this named environment.
          "preview_bucket_name": "komikhq-media-preview",
          // Keep local Wrangler development isolated from remote R2.
          "remote": false
        }
      ],
      // Explicitly enable Workers Cache for the named preview Worker.
      "cache": {
        "enabled": true
      }
    }
  }
}
