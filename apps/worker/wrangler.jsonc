{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "komikhq-media-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-09",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "replace-with-production-r2-bucket",
      "preview_bucket_name": "local-media-production-simulation",
      "remote": false
    }
  ],
  "previews": {
    "r2_buckets": [
      {
        "binding": "MEDIA_BUCKET",
        "bucket_name": "replace-with-preview-r2-bucket"
      }
    ]
  },
  "env": {
    "preview": {
      "name": "komikhq-media-worker-preview",
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "replace-with-preview-r2-bucket",
          "preview_bucket_name": "local-media-preview-simulation",
          "remote": false
        }
      ]
    }
  }
}
